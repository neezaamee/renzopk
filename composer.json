{
    "name": "renzo/restaurant-website",
    "description": "Renzo restaurant website and OTP-protected admin CMS structured for Laravel migration",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

